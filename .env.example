# ===== 阿里百炼 OpenAI 兼容接口 =====
# 课程提供的地址，或官方兼容地址：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的阿里百炼 API Key（必填，勿把真值提交到 Git）
DASHSCOPE_API_KEY=your_api_key_here

# 主模型：工具编排任务用 qwen-plus 更快；需要更强推理时换 qwen-max / qwen3.7-plus
LLM_MODEL=qwen-plus

# 子代理模型（留空则与主模型相同；可用 qwen-plus 降低成本）
SUBAGENT_MODEL=qwen-plus

# 采样温度
LLM_TEMPERATURE=0.3

# MCP 配置文件（本项目 4 个工具都是自定义工具，不依赖 MCP；保持默认即可）
MCP_CONFIG=mcp_servers.json
